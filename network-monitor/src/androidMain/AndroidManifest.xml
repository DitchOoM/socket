<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
      App Startup: contribute NetworkMonitorInitializer to androidx.startup's InitializationProvider so
      the consuming app gets a reactive NetworkMonitor without remembering to call
      NetworkMonitor.installAndroidContext(applicationContext) in Application.onCreate(). The initializer
      only captures the application Context — no ConnectivityManager callback is registered until
      something actually reads NetworkMonitor.processDefault().

      tools:node="merge" folds this <meta-data> into the provider androidx.startup's own manifest already
      declares, rather than redeclaring it. An app opts out with
      <meta-data android:name="com.ditchoom.socket.NetworkMonitorInitializer" tools:node="remove"/>.
    -->
    <application>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.ditchoom.socket.NetworkMonitorInitializer"
                android:value="androidx.startup"/>
        </provider>
    </application>
</manifest>
