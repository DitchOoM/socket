# The walk echo server, read by device-probe/*.sh and ios-probe/device/*.sh.
# Copy this file to walk-server.env (same directory, gitignored) and put your server in it:
#   cp walk-server.env.example walk-server.env
# An environment variable of the same name overrides the file for one invocation.

# One host, or a COMMA-separated list, one lane per host, all running at once (comma, not colon:
# an IPv6 literal is made of colons).
SERVER_HOST="192.0.2.1,2001:db8::1"
SERVER_PORT=44433
# The ssh target server-pull.sh reads the server's qlog from.
SERVER_SSH="root@192.0.2.1"
