<?xml version="1.0" encoding="utf-8"?>
<!--
  Instrumented-test manifest. WAKE_LOCK exists for DeviceHandoffProbe: a coroutine `delay` parks a
  thread and does NOT wake the application processor from suspend, so an unattended on-device probe
  (and the QUIC keepalive it depends on) stalls the moment the screen locks. A Doze whitelist does
  not substitute — that governs network policy, not CPU suspend.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      POST_NOTIFICATIONS carries DeviceHandoffProbe's live status notification, which is how a walk is
      driven by what the connection did rather than by a stopwatch. Declared here, but on API 33+ it is
      also a RUNTIME grant the instrumentation cannot request for itself:
        adb shell pm grant com.ditchoom.socket.quic.quiche.test android.permission.POST_NOTIFICATIONS
      Without it the probe logs one line and carries on notification-less — the recording is the
      deliverable, and it must not depend on the shade.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!--
      ACCESS_LOCAL_NETWORK lets P2pEchoServerProbe serve a phone on the same Wi-Fi. From API 37 an app
      without it never sees a datagram from a local-network peer: the kernel counts each one as a drop on
      the socket and nothing else says so, while a peer reaching the same socket from the internet gets
      through. A runtime grant, like POST_NOTIFICATIONS (device-probe/install.sh grants both).
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!--
      READ_PHONE_STATE is what lets the probe's OS-NET line carry the radio's registration state
      (IN_SERVICE / OUT_OF_SERVICE / POWER_OFF) and its data bearer. A phone registered on a roaming
      carrier with no data bearer looks, to everything else the walk records, exactly like airplane
      mode. Like POST_NOTIFICATIONS this is a RUNTIME grant the instrumentation cannot request for
      itself:
        adb shell pm grant com.ditchoom.socket.quic.quiche.test android.permission.READ_PHONE_STATE
      Without it those two fields report NotReported and every other fact still lands.
    -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <application>
        <!-- DeviceHandoffProbe's dead man's switch: posts "probe stopped" when its alarm was not pushed back. -->
        <receiver
            android:name="com.ditchoom.socket.quic.ProbeStoppedReceiver"
            android:exported="false" />
    </application>
</manifest>
